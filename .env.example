# Host bind port exposed by Docker Compose.
APP_PORT=3000

# Optional public base URL used for absolute metadata/canonical generation.
# Example: https://your-domain.com
APP_PUBLIC_URL=

# Persistent runtime state mounted into the container using the same absolute paths.
APP_DATA_DIR=/srv/platform/apps/applyron-portfolio/data
APP_UPLOADS_DIR=/srv/platform/apps/applyron-portfolio/uploads

# Optional. Leave unset to allow first-run setup until an admin exists.
# Set to false later if you want to hard-disable runtime setup in production.
ADMIN_SETUP_ENABLED=
